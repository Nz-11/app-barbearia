# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — SERVER ONLY. Never expose to the client/browser.
# Used exclusively in server-side API routes (app/api/**) to run the
# booking RPC with elevated privileges. Do NOT prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site URL (used for metadata / OG tags / sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
